# robot-diy-forum Controller 端到端测试脚本
# 适用于 IntelliJ IDEA HTTP Client、VS Code REST Client 或 curl
# 使用前请确保服务已启动（默认端口 8080）

@baseUrl = http://localhost:8080

# ============================================================
# 1. 用户注册
# ============================================================
POST {{baseUrl}}/user/register
Content-Type: application/json

{
  "username": "testuser",
  "email": "test@example.com",
  "nickname": "TestNick",
  "password": "123456"
}

# 预期响应：{ "code": 1, "msg": "注册成功", "data": null }

###

# ============================================================
# 2. 用户注册 - 参数校验失败（邮箱格式错误、密码过短）
# ============================================================
POST {{baseUrl}}/user/register
Content-Type: application/json

{
  "username": "u",
  "email": "invalid-email",
  "nickname": "n",
  "password": "123"
}

# 预期响应：HTTP 400 Bad Request

###

# ============================================================
# 3. 用户登录
# ============================================================
POST {{baseUrl}}/user/login
Content-Type: application/json

{
  "email": "test@example.com",
  "password": "123456"
}

# 预期响应：{ "code": 1, "msg": null, "data": "<jwt_token>" }
# 请将返回的 token 替换到下方 {{token}} 变量中

###

# ============================================================
# 4. 用户登录 - 账号不存在
# ============================================================
POST {{baseUrl}}/user/login
Content-Type: application/json

{
  "email": "notfound@example.com",
  "password": "wrongpass"
}

# 预期响应：{ "code": 0, "msg": "邮箱未注册", "data": null }

###

# ============================================================
# 5. 获取当前用户信息 - 未携带 Token
# ============================================================
GET {{baseUrl}}/user/me

# 预期响应：{ "code": 401, "msg": "当前用户未登录", "data": null }

###

# ============================================================
# 6. 获取当前用户信息 - 携带 Token
# ============================================================
# @no-redirect
GET {{baseUrl}}/user/me
Authorization: Bearer <替换为实际token>

# 预期响应：{ "code": 1, "msg": null, "data": { ...用户信息... } }

###

# ============================================================
# 7. 分类树 - 未携带 Token
# ============================================================
GET {{baseUrl}}/category/tree

# 预期响应：{ "code": 401, "msg": "当前用户未登录", "data": null }

###

# ============================================================
# 8. 分类树 - 携带 Token（仅返回启用状态分类）
# ============================================================
GET {{baseUrl}}/category/tree
Authorization: Bearer <替换为实际token>

# 预期响应：{ "code": 1, "msg": null, "data": [ ...分类树... ] }

###

# ============================================================
# 9. 新增分类
# ============================================================
POST {{baseUrl}}/category
Content-Type: application/json
Authorization: Bearer <替换为实际token>

{
  "parentId": 0,
  "name": "测试分类",
  "description": "这是一个测试分类"
}

# 预期响应：{ "code": 1, "msg": "新增成功", "data": null }

###

# ============================================================
# 10. 编辑分类
# ============================================================
# 请将 {id} 替换为实际分类 ID
PUT {{baseUrl}}/category/1
Content-Type: application/json
Authorization: Bearer <替换为实际token>

{
  "parentId": 0,
  "name": "测试分类-已更新",
  "description": "描述已更新"
}

# 预期响应：{ "code": 1, "msg": "编辑成功", "data": null }

###

# ============================================================
# 11. 启用分类
# ============================================================
# 请将 {id} 替换为实际分类 ID
PUT {{baseUrl}}/category/1/status?status=1
Authorization: Bearer <替换为实际token>

# 预期响应：{ "code": 1, "msg": null, "data": "启用成功" }

###

# ============================================================
# 12. 禁用分类
# ============================================================
# 请将 {id} 替换为实际分类 ID
PUT {{baseUrl}}/category/1/status?status=0
Authorization: Bearer <替换为实际token>

# 预期响应：{ "code": 1, "msg": null, "data": "禁用成功" }

###

# ============================================================
# 13. 切换状态 - 非法参数（status 只能是 0 或 1）
# ============================================================
# 请将 {id} 替换为实际分类 ID
PUT {{baseUrl}}/category/1/status?status=2
Authorization: Bearer <替换为实际token>

# 预期响应：{ "code": 400, "msg": "状态值只能是0或1", "data": null }

###

# ============================================================
# 14. 删除分类
# ============================================================
# 请将 {id} 替换为实际分类 ID
DELETE {{baseUrl}}/category/1
Authorization: Bearer <替换为实际token>

# 预期响应：{ "code": 1, "msg": "删除成功", "data": null }

###

# ============================================================
# 15. 删除分类 - 分类不存在
# ============================================================
DELETE {{baseUrl}}/category/999999
Authorization: Bearer <替换为实际token>

# 预期响应：{ "code": 400, "msg": "分类不存在", "data": null }
